{
  "manifest_version": 3,
  "name": "Quick Timesheet — Local Edition",
  "version": "0.2.1",
  "description": "Private local work logging and company-template weekly XLSX export.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Timesheet"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
